{
  "ignition": {
    "config": {
      "merge": [
        {
          "compression": "gzip",
          "source": "data:;base64,"
        }
      ]
    },
    "version": "3.4.0"
  },
  "storage": {
    "filesystems": [
      {
        "device": "/dev/sdb",
        "format": "ext4",
        "path": "/var",
        "wipeFilesystem": false
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "# Generated by Butane\n[Unit]\nRequires=systemd-fsck@dev-sdb.service\nAfter=systemd-fsck@dev-sdb.service\n\n[Mount]\nWhere=/var\nWhat=/dev/sdb\nType=ext4\n\n[Install]\nRequiredBy=local-fs.target",
        "enabled": true,
        "name": "var.mount"
      }
    ]
  }
}
